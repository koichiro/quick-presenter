import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct ThumbnailItem {
    page_index: int,
    page_label: string,
    image: image,
    is_current: bool,
}

component SlideView inherits Rectangle {
    in property <image> page-image;
    in property <float> page-aspect-ratio: 16.0 / 9.0;
    in property <bool> align-page-to-top: false;
    out property <length> page-surface-width: root.surface-width;
    out property <length> page-surface-height: root.surface-height;
    out property <length> page-surface-y: root.align-page-to-top ? 0px : (root.height - root.surface-height) / 2;

    background: transparent;
    property <float> safe-page-aspect-ratio: root.page-aspect-ratio > 0 ? root.page-aspect-ratio : 16.0 / 9.0;
    property <float> viewport-aspect-ratio: (root.width / 1px) / max(1, root.height / 1px);
    property <length> surface-width: root.viewport-aspect-ratio > root.safe-page-aspect-ratio ? root.height * root.safe-page-aspect-ratio : root.width;
    property <length> surface-height: root.viewport-aspect-ratio > root.safe-page-aspect-ratio ? root.height : root.width / root.safe-page-aspect-ratio;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.page-surface-y;
        width: root.surface-width;
        height: root.surface-height;
        background: #111315;
        border-color: #3c4043;
        border-width: 1px;

        Image {
            source: root.page-image;
            image-fit: fill;
            width: parent.width;
            height: parent.height;
        }
    }
}

component SlideProgressIndicator inherits Rectangle {
    in property <bool> has-progress: false;
    in property <float> progress-value: 0.0;
    in property <length> indicator-width: root.width;

    height: root.has-progress ? 4px : 0px;
    background: transparent;
    visible: root.has-progress;

    property <float> clamped-progress-value: max(0.0, min(1.0, root.progress-value));
    property <length> safe-indicator-width: max(0px, min(root.width, root.indicator-width));

    Rectangle {
        x: (root.width - self.width) / 2;
        y: 0px;
        width: root.safe-indicator-width;
        height: 4px;
        background: #3c4043;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.clamped-progress-value;
            height: parent.height;
            background: #8ab4f8;
        }
    }
}

component CurrentSlideWithProgress inherits Rectangle {
    in property <image> page-image;
    in property <float> page-aspect-ratio: 16.0 / 9.0;
    in property <bool> has-progress: false;
    in property <float> progress-value: 0.0;
    out property <length> page-surface-width: current-slide.page-surface-width;

    background: transparent;
    property <length> progress-height: root.has-progress ? 4px : 0px;

    current-slide := SlideView {
        page-image: root.page-image;
        page-aspect-ratio: root.page-aspect-ratio;
        align-page-to-top: true;
        width: parent.width;
        height: max(0px, parent.height - root.progress-height);
    }

    SlideProgressIndicator {
        y: min(parent.height - self.height, current-slide.page-surface-y + current-slide.page-surface-height);
        has-progress: root.has-progress;
        progress-value: root.progress-value;
        indicator-width: current-slide.page-surface-width;
        width: parent.width;
    }
}

// Keep visible notes and automatic sizing probes on the same typography.
component NotesText inherits TextInput {
    wrap: word-wrap;
    single-line: false;
    read-only: true;
    line-height-factor: 1.25;
}

component NotesMeasurement inherits NotesText {
    visible: false;
}

component NotesView inherits Rectangle {
    in property <bool> has-notes: false;
    in property <string> notes-text: "";
    in property <length> font-size: 12px;
    out property <length> visible-height: scroll-view.visible-height;
    out property <length> content-height: scroll-view.content-height;
    in-out property <length> scroll-y <=> scroll-view.content-y;
    out property <[float]> measured-heights: [
        measure-12.preferred-height / 1px,
        measure-13.preferred-height / 1px,
        measure-14.preferred-height / 1px,
        measure-15.preferred-height / 1px,
        measure-16.preferred-height / 1px,
        measure-17.preferred-height / 1px,
        measure-18.preferred-height / 1px,
        measure-19.preferred-height / 1px,
        measure-20.preferred-height / 1px,
        measure-21.preferred-height / 1px,
        measure-22.preferred-height / 1px,
        measure-23.preferred-height / 1px,
        measure-24.preferred-height / 1px
    ];
    callback fit-font-size(bool, float, float, [float]);

    background: #111315;
    border-color: #3c4043;
    border-width: 1px;

    function request-font-size() {
        root.fit-font-size(root.has-notes, scroll-view.visible-width / 1px, scroll-view.visible-height / 1px, root.measured-heights);
    }

    changed measured-heights => { root.request-font-size(); }
    changed has-notes => { root.request-font-size(); }
    changed notes-text => { root.request-font-size(); }

    function clamp-scroll-position() {
        scroll-view.content-y = max(min(0px, scroll-view.visible-height - scroll-view.content-height), min(0px, scroll-view.content-y));
    }

    measure-12 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 12px;
    }
    measure-13 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 13px;
    }
    measure-14 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 14px;
    }
    measure-15 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 15px;
    }
    measure-16 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 16px;
    }
    measure-17 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 17px;
    }
    measure-18 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 18px;
    }
    measure-19 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 19px;
    }
    measure-20 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 20px;
    }
    measure-21 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 21px;
    }
    measure-22 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 22px;
    }
    measure-23 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 23px;
    }
    measure-24 := NotesMeasurement {
        text: root.notes-text;
        width: scroll-view.visible-width;
        font-size: 24px;
    }

    scroll-view := ScrollView {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        content-width: self.visible-width;
        content-height: max(self.visible-height, notes-input.preferred-height + 10px);
        vertical-scrollbar-policy: root.has-notes ? ScrollBarPolicy.always-on : ScrollBarPolicy.as-needed;

        changed visible-width => { root.request-font-size(); }
        changed visible-height => {
            root.request-font-size();
            root.clamp-scroll-position();
        }
        changed content-height => { root.clamp-scroll-position(); }

        notes-input := NotesText {
            text: root.has-notes ? root.notes-text : "No notes";
            font-size: root.has-notes ? root.font-size : 12px;
            color: root.has-notes ? #f1f3f4 : #9aa0a6;
            page-height: scroll-view.visible-height;
            text-cursor-width: 0px;
            key-pressed(event) => { reject }
            key-released(event) => { reject }
        }
    }
}

component PresenterMenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    width: 72px;
    height: 28px;
    background: root.active ? #d6e3f8 : (touch.has-hover ? #e8eef8 : #f1f3f4);

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: #202124;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component PresenterMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    background: root.enabled && touch.has-hover ? #d6e3f8 : #f8f9fa;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: root.enabled ? #202124 : #8a8f95;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Keep standard button focus, keyboard activation, and accessibility behavior.
component NavigationButton inherits Button {
    in property <string> action-name;
    in property <string> shortcut-label;

    min-width: 40px;
    max-width: 40px;
    height: 32px;
    icon-size: 18px;
    colorize-icon: true;
    accessible-label: root.action-name;

    Tooltip {
        text: @markdown("\{root.action-name} (\{root.shortcut-label})");
    }
}

