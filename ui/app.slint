import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct ThumbnailItem {
    page_index: int,
    page_label: string,
    image: image,
    is_current: bool,
}

component SlideView inherits Rectangle {
    in property <image> page-image;
    in property <float> page-aspect-ratio: 16.0 / 9.0;
    in property <bool> align-page-to-top: false;
    out property <length> page-surface-width: root.surface-width;
    out property <length> page-surface-height: root.surface-height;
    out property <length> page-surface-y: root.align-page-to-top ? 0px : (root.height - root.surface-height) / 2;

    background: transparent;
    property <float> safe-page-aspect-ratio: root.page-aspect-ratio > 0 ? root.page-aspect-ratio : 16.0 / 9.0;
    property <float> viewport-aspect-ratio: (root.width / 1px) / max(1, root.height / 1px);
    property <length> surface-width: root.viewport-aspect-ratio > root.safe-page-aspect-ratio ? root.height * root.safe-page-aspect-ratio : root.width;
    property <length> surface-height: root.viewport-aspect-ratio > root.safe-page-aspect-ratio ? root.height : root.width / root.safe-page-aspect-ratio;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.page-surface-y;
        width: root.surface-width;
        height: root.surface-height;
        background: #111315;
        border-color: #3c4043;
        border-width: 1px;

        Image {
            source: root.page-image;
            image-fit: fill;
            width: parent.width;
            height: parent.height;
        }
    }
}

component SlideProgressIndicator inherits Rectangle {
    in property <bool> has-progress: false;
    in property <float> progress-value: 0.0;
    in property <length> indicator-width: root.width;

    height: root.has-progress ? 4px : 0px;
    background: transparent;
    visible: root.has-progress;

    property <float> clamped-progress-value: max(0.0, min(1.0, root.progress-value));
    property <length> safe-indicator-width: max(0px, min(root.width, root.indicator-width));

    Rectangle {
        x: (root.width - self.width) / 2;
        y: 0px;
        width: root.safe-indicator-width;
        height: 4px;
        background: #3c4043;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.clamped-progress-value;
            height: parent.height;
            background: #8ab4f8;
        }
    }
}

component CurrentSlideWithProgress inherits Rectangle {
    in property <image> page-image;
    in property <float> page-aspect-ratio: 16.0 / 9.0;
    in property <bool> has-progress: false;
    in property <float> progress-value: 0.0;
    out property <length> page-surface-width: current-slide.page-surface-width;

    background: transparent;
    property <length> progress-height: root.has-progress ? 4px : 0px;

    current-slide := SlideView {
        page-image: root.page-image;
        page-aspect-ratio: root.page-aspect-ratio;
        align-page-to-top: true;
        width: parent.width;
        height: max(0px, parent.height - root.progress-height);
    }

    SlideProgressIndicator {
        y: min(parent.height - self.height, current-slide.page-surface-y + current-slide.page-surface-height);
        has-progress: root.has-progress;
        progress-value: root.progress-value;
        indicator-width: current-slide.page-surface-width;
        width: parent.width;
    }
}

component NotesView inherits Rectangle {
    in property <bool> has-notes: false;
    in property <string> notes-text: "";

    background: #111315;
    border-color: #3c4043;
    border-width: 1px;
    accessible-role: groupbox;
    accessible-label: "Speaker notes";
    accessible-description: root.has-notes ? root.notes-text : "No speaker notes";

    scroll-view := ScrollView {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, notes-input.preferred-height + 10px);
        vertical-scrollbar-policy: root.has-notes ? ScrollBarPolicy.always-on : ScrollBarPolicy.as-needed;

        notes-input := TextInput {
            text: root.has-notes ? root.notes-text : "No notes";
            color: root.has-notes ? #f1f3f4 : #9aa0a6;
            wrap: word-wrap;
            single-line: false;
            read-only: true;
            page-height: scroll-view.visible-height;
            text-cursor-width: 0px;
            key-pressed(event) => {
                reject
            }
            key-released(event) => {
                reject
            }
        }
    }
}

component PresenterMenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    width: 72px;
    height: 28px;
    background: root.active ? #d6e3f8 : (touch.has-hover ? #e8eef8 : #f1f3f4);
    border-color: menu-focus.has-focus ? #185abc : transparent;
    border-width: menu-focus.has-focus ? 2px : 0px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: true;
    accessible-expandable: true;
    accessible-expanded: root.active;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: menu-focus;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: #202124;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    menu-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }

            return reject;
        }
    }
}

component PresenterMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    background: root.enabled && touch.has-hover ? #d6e3f8 : #f8f9fa;
    border-color: item-focus.has-focus ? #185abc : transparent;
    border-width: item-focus.has-focus ? 2px : 0px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    forward-focus: item-focus;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: root.enabled ? #202124 : #8a8f95;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    item-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }

            return reject;
        }
    }
}

