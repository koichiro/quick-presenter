component ThumbnailTile inherits Rectangle {
    in property <ThumbnailItem> thumbnail;
    callback clicked(int);

    height: 92px;
    background: root.thumbnail.is_current ? #23395d : #111315;
    border-color: thumbnail-focus.has-focus ? #fbbc04 : (root.thumbnail.is_current ? #8ab4f8 : #3c4043);
    border-width: thumbnail-focus.has-focus || root.thumbnail.is_current ? 2px : 1px;
    accessible-role: list-item;
    accessible-label: root.thumbnail.is_current ? root.thumbnail.page_label + ", current slide" : root.thumbnail.page_label;
    accessible-enabled: true;
    accessible-item-selectable: true;
    accessible-item-selected: root.thumbnail.is_current;
    accessible-action-default => {
        root.clicked(root.thumbnail.page_index);
    }
    forward-focus: thumbnail-focus;

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked(root.thumbnail.page_index);
        }
    }

    thumbnail-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked(root.thumbnail.page_index);
                return accept;
            }

            return reject;
        }
    }

    Image {
        source: root.thumbnail.image;
        image-fit: contain;
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: 62px;
    }

    Text {
        text: root.thumbnail.is_current ? "CURRENT  " + root.thumbnail.page_label : root.thumbnail.page_label;
        color: root.thumbnail.is_current ? #f1f3f4 : #d9dce0;
        x: 6px;
        y: 69px;
        width: parent.width - 12px;
        height: 18px;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ThumbnailPane inherits Rectangle {
    in property <[ThumbnailItem]> thumbnails;
    in property <int> current-page-index: 0;
    callback jump-to-page(int);
    callback request-thumbnail-range(int, int);

    background: transparent;
    accessible-role: list;
    accessible-label: "Slide thumbnails";
    accessible-item-count: root.thumbnails.length;
    private property <length> scrollbar-gutter-width: 12px;
    private property <length> tile-height: 98px;
    private property <length> current-item-y: scroll-view.viewport-y + root.current-page-index * root.tile-height;
    private property <int> visible-start-index: max(0, round(-scroll-view.viewport-y / root.tile-height));
    private property <int> visible-end-index: min(root.thumbnails.length - 1, max(0, round((-scroll-view.viewport-y + scroll-view.visible-height) / root.tile-height) + 1));

    function bring-current-into-view() {
        if root.current-page-index < 0 || root.current-page-index >= root.thumbnails.length {
            return;
        }

        if current-item-y < 0px {
            scroll-view.viewport-y += 0px - current-item-y;
        }

        if current-item-y + tile-height > scroll-view.visible-height {
            scroll-view.viewport-y -= current-item-y + tile-height - scroll-view.visible-height;
        }
    }

    function request-visible-thumbnails() {
        if root.thumbnails.length <= 0 {
            return;
        }

        root.request-thumbnail-range(root.visible-start-index, root.visible-end-index);
    }

    changed current-page-index => {
        root.bring-current-into-view();
        root.request-visible-thumbnails();
    }

    changed thumbnails => {
        root.request-visible-thumbnails();
    }

    changed visible-start-index => {
        root.request-visible-thumbnails();
    }

    changed visible-end-index => {
        root.request-visible-thumbnails();
    }

    scroll-view := ScrollView {
        width: parent.width + root.scrollbar-gutter-width;
        height: parent.height;
        viewport-width: parent.width;

        VerticalBox {
            width: root.width;
            spacing: 6px;

            for thumbnail in root.thumbnails: ThumbnailTile {
                thumbnail: thumbnail;
                width: parent.width;
                clicked(page-index) => {
                    root.jump-to-page(page-index);
                }
            }
        }
    }
}

export component PresenterWindow inherits Window {
    in property <image> current-page-image;
    in property <image> next-page-image;
    in property <float> current-page-aspect-ratio: 16.0 / 9.0;
    in property <float> next-page-aspect-ratio: 16.0 / 9.0;
    in property <bool> has-next-page: false;
    in property <bool> has-notes: false;
    in property <string> document-title: "No PDF opened";
    in property <string> page-label: "";
    in property <string> notes-text: "";
    in property <bool> slide-fullscreen: false;
    in property <bool> use-physical-control-shortcuts: false;
    in property <bool> use-native-menu-bar: true;
    in property <string> clock-time-label: "--:--";
    in property <string> elapsed-time-label: "00:00";
    in property <string> status-text: "Open a PDF to start";
    in property <bool> has-slide-progress: false;
    in property <float> slide-progress-value: 0.0;
    in property <bool> has-recent-files: false;
    in property <string> recent-file-label-0: "No Recent Files";
    in property <string> recent-file-label-1: "";
    in property <string> recent-file-label-2: "";
    in property <string> recent-file-label-3: "";
    in property <string> recent-file-label-4: "";
    in property <bool> recent-file-0-enabled: false;
    in property <bool> recent-file-1-enabled: false;
    in property <bool> recent-file-2-enabled: false;
    in property <bool> recent-file-3-enabled: false;
    in property <bool> recent-file-4-enabled: false;
    in property <string> about-app-name: "Quick Presenter";
    in property <string> about-version-label: "";
    in property <string> about-license-id: "";
    in property <string> about-license-summary: "";
    in property <string> about-pdfium-version-label: "";
    in property <string> about-pdfium-license-summary: "";
    in property <[ThumbnailItem]> thumbnails: [];
    in property <int> current-page-index: 0;
    property <bool> about-visible: false;
    property <int> active-menu-index: -1;
    property <length> inline-menu-height: root.use-native-menu-bar ? 0px : 28px;
    property <length> presenter-main-height: max(0px, root.height - root.inline-menu-height - 96px);
    property <length> presenter-bottom-section-height: 180px;
    property <float> safe-current-page-aspect-ratio: root.current-page-aspect-ratio > 0 ? root.current-page-aspect-ratio : 16.0 / 9.0;
    property <float> safe-next-page-aspect-ratio: root.next-page-aspect-ratio > 0 ? root.next-page-aspect-ratio : 16.0 / 9.0;
    property <length> next-preview-natural-height: 260px / root.safe-next-page-aspect-ratio;
    property <length> next-preview-height: root.next-preview-natural-height > 190px ? 190px : root.next-preview-natural-height;

    callback open-pdf();
    callback open-recent-file(int);
    callback clear-recent-files();
    callback previous-page();
    callback next-page();
    callback first-page();
    callback last-page();
    callback toggle-black-screen();
    callback toggle-slide-fullscreen();
    callback exit-slide-fullscreen();
    callback show-presenter-window();
    callback show-slide-window();
    callback hide-slide-window();
    callback bring-presenter-window-to-front();
    callback bring-slide-window-to-front();
    callback keyboard-previous-page();
    callback keyboard-next-page();
    callback keyboard-first-page();
    callback keyboard-last-page();
    callback jump-to-page(int);
    callback request-thumbnail-range(int, int);

    title: "Quick Presenter";
    preferred-width: 1024px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 560px;
    background: #202124;
    forward-focus: presenter-focus;

    // BEGIN_NATIVE_MENU_BAR
    if root.use-native-menu-bar: MenuBar {
        Menu {
            title: "File";

            MenuItem {
                title: "Open PDF...";
                activated => {
                    root.open-pdf();
                }
            }

            Menu {
                title: "Open Recent";
                enabled: root.has-recent-files;

                MenuItem {
                    title: root.recent-file-label-0;
                    enabled: root.recent-file-0-enabled;
                    activated => { root.open-recent-file(0); }
                }

                MenuItem {
                    title: root.recent-file-label-1;
                    enabled: root.recent-file-1-enabled;
                    activated => { root.open-recent-file(1); }
                }

                MenuItem {
                    title: root.recent-file-label-2;
                    enabled: root.recent-file-2-enabled;
                    activated => { root.open-recent-file(2); }
                }

                MenuItem {
                    title: root.recent-file-label-3;
                    enabled: root.recent-file-3-enabled;
                    activated => { root.open-recent-file(3); }
                }

                MenuItem {
                    title: root.recent-file-label-4;
                    enabled: root.recent-file-4-enabled;
                    activated => { root.open-recent-file(4); }
                }

                MenuSeparator { }

                MenuItem {
                    title: "Clear Recent Files";
                    enabled: root.has-recent-files;
                    activated => {
                        root.clear-recent-files();
                    }
                }
            }
        }

        Menu {
            title: "Navigate";

            MenuItem {
                title: "Previous Page";
                activated => {
                    root.previous-page();
                }
            }

            MenuItem {
                title: "Next Page";
                activated => {
                    root.next-page();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "First Page";
                activated => {
                    root.first-page();
                }
            }

            MenuItem {
                title: "Last Page";
                activated => {
                    root.last-page();
                }
            }
        }

        Menu {
            title: "View";

            MenuItem {
                title: "Toggle Slide Fullscreen";
                activated => {
                    root.toggle-slide-fullscreen();
                }
            }

            MenuItem {
                title: "Toggle Black Screen";
                activated => {
                    root.toggle-black-screen();
                }
            }
        }

        Menu {
            title: "Window";

            MenuItem {
                title: "Show Presenter Window";
                activated => {
                    root.show-presenter-window();
                }
            }

            MenuItem {
                title: "Show Slide Window";
                activated => {
                    root.show-slide-window();
                }
            }

            MenuItem {
                title: "Hide Slide Window";
                activated => {
                    root.hide-slide-window();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "Bring Presenter Window to Front";
                activated => {
                    root.bring-presenter-window-to-front();
                }
            }

            MenuItem {
                title: "Bring Slide Window to Front";
                activated => {
                    root.bring-slide-window-to-front();
                }
            }
        }

        Menu {
            title: "Help";

            MenuItem {
                title: "About Quick Presenter";
                activated => {
                    root.about-visible = true;
                }
            }
        }
    }
    // END_NATIVE_MENU_BAR

    presenter-focus := FocusScope {
        width: root.width;
        height: root.height;

        KeyBinding {
            keys: @keys(Space);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(PageDown);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(PageUp);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Backspace);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Home);
            activated => {
                root.keyboard-first-page();
            }
        }

        if !root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Control + A);
            activated => {
                root.keyboard-first-page();
            }
        }

        if root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Meta + A);
            activated => {
                root.keyboard-first-page();
            }
        }

        KeyBinding {
            keys: @keys(End);
            activated => {
                root.keyboard-last-page();
            }
        }

        if !root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Control + E);
            activated => {
                root.keyboard-last-page();
            }
        }

        if root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Meta + E);
            activated => {
                root.keyboard-last-page();
            }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.exit-slide-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(F5);
            activated => {
                root.toggle-slide-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(F);
            activated => {
                root.toggle-slide-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(B);
            activated => {
                root.toggle-black-screen();
            }
        }

        Rectangle {
            width: root.width;
            height: root.height;
            background: #202124;

            HorizontalBox {
                x: 12px;
                y: root.inline-menu-height + 12px;
                width: parent.width - 24px;
                height: 36px;
                spacing: 8px;

                Button {
                    text: "Open";
                    clicked => {
                        root.open-pdf();
                    }
                }

                Button {
                    text: "Previous";
                    clicked => {
                        root.previous-page();
                    }
                }

                Button {
                    text: "Next";
                    clicked => {
                        root.next-page();
                    }
                }

                Button {
                    text: root.slide-fullscreen ? "Exit Fullscreen" : "Fullscreen";
                    clicked => {
                        root.toggle-slide-fullscreen();
                    }
                }

                Button {
                    text: "Black";
                    clicked => {
                        root.toggle-black-screen();
                    }
                }

                Text {
                    text: root.document-title;
                    color: white;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: root.elapsed-time-label;
                    color: #f1f3f4;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.clock-time-label;
                    color: #d9dce0;
                    vertical-alignment: center;
                }

                Text {
                    text: root.page-label;
                    color: #d9dce0;
                    vertical-alignment: center;
                }
            }

            main-area := Rectangle {
                x: 12px;
                y: root.inline-menu-height + 54px;
                width: parent.width - 24px;
                height: root.presenter-main-height;
                property <length> column-gap: 10px;
                property <length> next-column-width: 260px;
                property <length> thumbnail-column-width: 128px;
                property <length> left-column-width: max(0px, main-area.width - main-area.next-column-width - main-area.thumbnail-column-width - main-area.column-gap * 2);
                property <length> current-slide-natural-height: main-area.left-column-width / root.safe-current-page-aspect-ratio + (root.has-slide-progress ? 4px : 0px);
                property <length> top-section-height: min(main-area.current-slide-natural-height, max(0px, main-area.height - root.presenter-bottom-section-height - 34px));
                property <length> lower-section-y: main-area.top-section-height;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: main-area.left-column-width;
                    height: parent.height;

                    current-slide-with-progress := CurrentSlideWithProgress {
                        x: 0px;
                        y: 0px;
                        page-image: root.current-page-image;
                        page-aspect-ratio: root.current-page-aspect-ratio;
                        has-progress: root.has-slide-progress;
                        progress-value: root.slide-progress-value;
                        width: parent.width;
                        height: main-area.top-section-height;
                    }

                    Rectangle {
                        y: main-area.lower-section-y + 6px;
                        height: 22px;
                        width: parent.width;

                        Text {
                            x: (parent.width - self.width) / 2;
                            width: current-slide-with-progress.page-surface-width;
                            height: parent.height;
                            text: "Notes";
                            color: #d9dce0;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        y: main-area.lower-section-y + 34px;
                        width: parent.width;
                        height: max(0px, parent.height - self.y);

                        NotesView {
                            x: (parent.width - self.width) / 2;
                            width: current-slide-with-progress.page-surface-width;
                            height: parent.height;
                            has-notes: root.has-notes;
                            notes-text: root.notes-text;
                        }
                    }
                }

                Rectangle {
                    x: main-area.left-column-width + main-area.column-gap;
                    y: 0px;
                    width: main-area.next-column-width;
                    height: parent.height;
                    property <length> preview-height: min(root.next-preview-height, main-area.top-section-height);

                    next-preview-slot := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.preview-height;

                        SlideView {
                            x: 0px;
                            y: 0px;
                            page-image: root.next-page-image;
                            page-aspect-ratio: root.next-page-aspect-ratio;
                            align-page-to-top: true;
                            visible: root.has-next-page;
                            width: parent.width;
                            height: parent.height;
                        }

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            visible: !root.has-next-page;
                            background: #111315;
                            border-color: #3c4043;
                            border-width: 1px;
                            width: parent.width;
                            height: parent.height;

                            Text {
                                text: "No next slide";
                                color: #9aa0a6;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }

                    Text {
                        x: 0px;
                        y: main-area.lower-section-y + 6px;
                        text: "Keys";
                        color: #d9dce0;
                        width: parent.width;
                        height: 22px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }

                    KeyboardBindingsPanel {
                        y: main-area.lower-section-y + 34px;
                        width: parent.width;
                        height: max(0px, parent.height - self.y);
                    }
                }

                Rectangle {
                    x: main-area.left-column-width + main-area.column-gap + main-area.next-column-width + main-area.column-gap;
                    y: 0px;
                    width: main-area.thumbnail-column-width;
                    height: parent.height;

                    ThumbnailPane {
                        x: 0px;
                        y: 0px;
                        thumbnails: root.thumbnails;
                        current-page-index: root.current-page-index;
                        width: parent.width;
                        height: parent.height;
                        jump-to-page(page-index) => {
                            root.jump-to-page(page-index);
                        }
                        request-thumbnail-range(first-index, last-index) => {
                            root.request-thumbnail-range(first-index, last-index);
                        }
                    }
                }
            }

            Text {
                x: 12px;
                y: max(0px, parent.height - 36px);
                width: parent.width - 24px;
                text: root.status-text;
                color: #d9dce0;
                height: 24px;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                y: 0px;
                width: parent.width;
                height: root.inline-menu-height;
                visible: !root.use-native-menu-bar;
                background: #f1f3f4;

                PresenterMenuButton {
                    x: 0px;
                    width: 56px;
                    text: "File";
                    active: root.active-menu-index == 0;
                    clicked => { root.active-menu-index = root.active-menu-index == 0 ? -1 : 0; }
                }

                PresenterMenuButton {
                    x: 56px;
                    width: 92px;
                    text: "Navigate";
                    active: root.active-menu-index == 1;
                    clicked => { root.active-menu-index = root.active-menu-index == 1 ? -1 : 1; }
                }

                PresenterMenuButton {
                    x: 148px;
                    width: 64px;
                    text: "View";
                    active: root.active-menu-index == 2;
                    clicked => { root.active-menu-index = root.active-menu-index == 2 ? -1 : 2; }
                }

                PresenterMenuButton {
                    x: 212px;
                    width: 86px;
                    text: "Window";
                    active: root.active-menu-index == 3;
                    clicked => { root.active-menu-index = root.active-menu-index == 3 ? -1 : 3; }
                }

                PresenterMenuButton {
                    x: 298px;
                    width: 64px;
                    text: "Help";
                    active: root.active-menu-index == 4;
                    clicked => { root.active-menu-index = root.active-menu-index == 4 ? -1 : 4; }
                }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 0: Rectangle {
                x: 0px;
                y: root.inline-menu-height;
                width: 220px;
                height: 196px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { y: 0px; width: parent.width; text: "Open PDF..."; clicked => { root.active-menu-index = -1; root.open-pdf(); } }
                PresenterMenuItem { y: 28px; width: parent.width; text: root.recent-file-label-0; enabled: root.recent-file-0-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(0); } }
                PresenterMenuItem { y: 56px; width: parent.width; text: root.recent-file-label-1; enabled: root.recent-file-1-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(1); } }
                PresenterMenuItem { y: 84px; width: parent.width; text: root.recent-file-label-2; enabled: root.recent-file-2-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(2); } }
                PresenterMenuItem { y: 112px; width: parent.width; text: root.recent-file-label-3; enabled: root.recent-file-3-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(3); } }
                PresenterMenuItem { y: 140px; width: parent.width; text: root.recent-file-label-4; enabled: root.recent-file-4-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(4); } }
                PresenterMenuItem { y: 168px; width: parent.width; text: "Clear Recent Files"; enabled: root.has-recent-files; clicked => { root.active-menu-index = -1; root.clear-recent-files(); } }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 1: Rectangle {
                x: 56px;
                y: root.inline-menu-height;
                width: 180px;
                height: 112px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { y: 0px; width: parent.width; text: "Previous Page"; clicked => { root.active-menu-index = -1; root.previous-page(); } }
                PresenterMenuItem { y: 28px; width: parent.width; text: "Next Page"; clicked => { root.active-menu-index = -1; root.next-page(); } }
                PresenterMenuItem { y: 56px; width: parent.width; text: "First Page"; clicked => { root.active-menu-index = -1; root.first-page(); } }
                PresenterMenuItem { y: 84px; width: parent.width; text: "Last Page"; clicked => { root.active-menu-index = -1; root.last-page(); } }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 2: Rectangle {
                x: 148px;
                y: root.inline-menu-height;
                width: 210px;
                height: 56px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { y: 0px; width: parent.width; text: "Toggle Slide Fullscreen"; clicked => { root.active-menu-index = -1; root.toggle-slide-fullscreen(); } }
                PresenterMenuItem { y: 28px; width: parent.width; text: "Toggle Black Screen"; clicked => { root.active-menu-index = -1; root.toggle-black-screen(); } }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 3: Rectangle {
                x: 212px;
                y: root.inline-menu-height;
                width: 240px;
                height: 140px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { y: 0px; width: parent.width; text: "Show Presenter Window"; clicked => { root.active-menu-index = -1; root.show-presenter-window(); } }
                PresenterMenuItem { y: 28px; width: parent.width; text: "Show Slide Window"; clicked => { root.active-menu-index = -1; root.show-slide-window(); } }
                PresenterMenuItem { y: 56px; width: parent.width; text: "Hide Slide Window"; clicked => { root.active-menu-index = -1; root.hide-slide-window(); } }
                PresenterMenuItem { y: 84px; width: parent.width; text: "Bring Presenter Window to Front"; clicked => { root.active-menu-index = -1; root.bring-presenter-window-to-front(); } }
                PresenterMenuItem { y: 112px; width: parent.width; text: "Bring Slide Window to Front"; clicked => { root.active-menu-index = -1; root.bring-slide-window-to-front(); } }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 4: Rectangle {
                x: 298px;
                y: root.inline-menu-height;
                width: 210px;
                height: 28px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { width: parent.width; text: "About Quick Presenter"; clicked => { root.active-menu-index = -1; root.about-visible = true; } }
            }
        }

    }

    if root.about-visible : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.about-visible = false;
            }
        }

        Rectangle {
            width: min(parent.width - 48px, 560px);
            height: min(parent.height - 48px, 420px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #202124;
            border-color: #5f6368;
            border-width: 1px;

            VerticalBox {
                padding: 24px;
                spacing: 12px;

                HorizontalBox {
                    height: 96px;
                    spacing: 16px;

                    Image {
                        source: @image-url("../assets/icons/png/quick-presenter-icon-128.png");
                        image-fit: contain;
                        width: 88px;
                        height: 88px;
                    }

                    VerticalBox {
                        spacing: 4px;
                        vertical-stretch: 1;

                        Text {
                            text: root.about-app-name;
                            color: #f1f3f4;
                            font-size: 28px;
                            font-weight: 700;
                            height: 36px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.about-version-label;
                            color: #d9dce0;
                            height: 24px;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #3c4043;
                }

                Text {
                    text: "Application License";
                    color: #f1f3f4;
                    font-weight: 700;
                    height: 24px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.about-license-id + "\n" + root.about-license-summary;
                    color: #d9dce0;
                    wrap: word-wrap;
                    height: 54px;
                }

                Text {
                    text: "Bundled Components";
                    color: #f1f3f4;
                    font-weight: 700;
                    height: 24px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.about-pdfium-version-label + "\n" + root.about-pdfium-license-summary;
                    color: #d9dce0;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                    overflow: clip;
                }

                HorizontalBox {
                    height: 36px;
                    alignment: end;

                    Button {
                        text: "Close";
                        clicked => {
                            root.about-visible = false;
                        }
                    }
                }
            }
        }
    }
}

export component SlideWindow inherits Window {
    in property <image> page-image;
    in property <float> page-aspect-ratio: 16.0 / 9.0;
    in property <length> slide-window-width: 1024px;
    in property <length> slide-window-height: 720px;
    in property <length> titlebar-compensation-height: 0px;
    in property <bool> use-physical-control-shortcuts: false;

    callback exit-fullscreen();
    callback toggle-black-screen();
    callback toggle-slide-fullscreen();
    callback keyboard-previous-page();
    callback keyboard-next-page();
    callback keyboard-first-page();
    callback keyboard-last-page();

    title: "Quick Presenter - Slide";
    preferred-width: root.slide-window-width;
    preferred-height: root.slide-window-height;
    min-width: 640px;
    min-height: 360px;
    max-width: root.slide-window-width;
    max-height: root.slide-window-height;
    background: #111315;
    forward-focus: slide-focus;

    slide-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.exit-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(Space);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(PageDown);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(PageUp);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Backspace);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Home);
            activated => {
                root.keyboard-first-page();
            }
        }

        if !root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Control + A);
            activated => {
                root.keyboard-first-page();
            }
        }

        if root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Meta + A);
            activated => {
                root.keyboard-first-page();
            }
        }

        KeyBinding {
            keys: @keys(End);
            activated => {
                root.keyboard-last-page();
            }
        }

        if !root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Control + E);
            activated => {
                root.keyboard-last-page();
            }
        }

        if root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Meta + E);
            activated => {
                root.keyboard-last-page();
            }
        }

        KeyBinding {
            keys: @keys(F5);
            activated => {
                root.toggle-slide-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(F);
            activated => {
                root.toggle-slide-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(B);
            activated => {
                root.toggle-black-screen();
            }
        }

        SlideView {
            page-image: root.page-image;
            page-aspect-ratio: root.page-aspect-ratio;
            width: parent.width;
            height: parent.height;
        }

    }
}
