import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

component SlideView inherits Rectangle {
    in property <image> page-image;
    in property <float> page-aspect-ratio: 16.0 / 9.0;

    background: transparent;
    property <float> safe-page-aspect-ratio: root.page-aspect-ratio > 0 ? root.page-aspect-ratio : 16.0 / 9.0;
    property <float> viewport-aspect-ratio: (root.width / 1px) / max(1, root.height / 1px);
    property <length> surface-width: root.viewport-aspect-ratio > root.safe-page-aspect-ratio ? root.height * root.safe-page-aspect-ratio : root.width;
    property <length> surface-height: root.viewport-aspect-ratio > root.safe-page-aspect-ratio ? root.height : root.width / root.safe-page-aspect-ratio;

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.surface-width;
        height: root.surface-height;
        background: #111315;
        border-color: #3c4043;
        border-width: 1px;

        Image {
            source: root.page-image;
            image-fit: contain;
            width: parent.width;
            height: parent.height;
        }
    }
}

component NotesView inherits Rectangle {
    in property <bool> has-notes: false;
    in property <string> notes-text: "";

    background: #111315;
    border-color: #3c4043;
    border-width: 1px;

    Text {
        text: root.has-notes ? root.notes-text : "No notes";
        color: root.has-notes ? #f1f3f4 : #9aa0a6;
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        wrap: word-wrap;
        overflow: clip;
    }
}

export component PresenterWindow inherits Window {
    in property <image> current-page-image;
    in property <image> next-page-image;
    in property <float> current-page-aspect-ratio: 16.0 / 9.0;
    in property <float> next-page-aspect-ratio: 16.0 / 9.0;
    in property <bool> has-next-page: false;
    in property <bool> has-notes: false;
    in property <string> document-title: "No PDF opened";
    in property <string> page-label: "";
    in property <string> notes-text: "";
    in property <bool> slide-fullscreen: false;
    in property <string> clock-time-label: "--:--";
    in property <string> elapsed-time-label: "00:00";
    in property <string> status-text: "Open a PDF to start";

    callback open-pdf();
    callback previous-page();
    callback next-page();
    callback toggle-slide-fullscreen();
    callback exit-slide-fullscreen();
    callback keyboard-previous-page();
    callback keyboard-next-page();
    callback keyboard-first-page();
    callback keyboard-last-page();

    title: "Quick Presenter";
    preferred-width: 1024px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 560px;
    background: #202124;
    forward-focus: presenter-focus;

    presenter-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        KeyBinding {
            keys: @keys(Space);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(PageDown);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(PageUp);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Backspace);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Home);
            activated => {
                root.keyboard-first-page();
            }
        }

        KeyBinding {
            keys: @keys(End);
            activated => {
                root.keyboard-last-page();
            }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.exit-slide-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(F5);
            activated => {
                root.toggle-slide-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(F);
            activated => {
                root.toggle-slide-fullscreen();
            }
        }

        VerticalBox {
            padding: 12px;
            spacing: 10px;

            HorizontalBox {
                height: 36px;
                spacing: 8px;

                Button {
                    text: "Open PDF";
                    clicked => {
                        root.open-pdf();
                    }
                }

                Button {
                    text: "Previous";
                    clicked => {
                        root.previous-page();
                    }
                }

                Button {
                    text: "Next";
                    clicked => {
                        root.next-page();
                    }
                }

                Button {
                    text: root.slide-fullscreen ? "Exit Fullscreen" : "Fullscreen";
                    clicked => {
                        root.toggle-slide-fullscreen();
                    }
                }

                Text {
                    text: root.document-title;
                    color: white;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: root.elapsed-time-label;
                    color: #f1f3f4;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.clock-time-label;
                    color: #d9dce0;
                    vertical-alignment: center;
                }

                Text {
                    text: root.page-label;
                    color: #d9dce0;
                    vertical-alignment: center;
                }
            }

            HorizontalBox {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: 10px;

                VerticalBox {
                    horizontal-stretch: 3;
                    vertical-stretch: 1;
                    spacing: 6px;

                    SlideView {
                        page-image: root.current-page-image;
                        page-aspect-ratio: root.current-page-aspect-ratio;
                        horizontal-stretch: 1;
                        vertical-stretch: 4;
                    }

                    Text {
                        text: "Notes";
                        color: #d9dce0;
                        height: 22px;
                        vertical-alignment: center;
                    }

                    NotesView {
                        has-notes: root.has-notes;
                        notes-text: root.notes-text;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                    }
                }

                VerticalBox {
                    width: 260px;
                    spacing: 6px;

                    Text {
                        text: "Next";
                        color: #d9dce0;
                        height: 22px;
                        vertical-alignment: center;
                    }

                    SlideView {
                        page-image: root.next-page-image;
                        page-aspect-ratio: root.next-page-aspect-ratio;
                        visible: root.has-next-page;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                    }

                    Rectangle {
                        visible: !root.has-next-page;
                        background: #111315;
                        border-color: #3c4043;
                        border-width: 1px;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;

                        Text {
                            text: "End";
                            color: #d9dce0;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }

            Text {
                text: root.status-text;
                color: #d9dce0;
                height: 24px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component SlideWindow inherits Window {
    in property <image> page-image;
    in property <float> page-aspect-ratio: 16.0 / 9.0;
    in property <length> slide-window-width: 1024px;
    in property <length> slide-window-height: 720px;

    callback exit-fullscreen();
    callback toggle-slide-fullscreen();
    callback keyboard-previous-page();
    callback keyboard-next-page();
    callback keyboard-first-page();
    callback keyboard-last-page();

    title: "Quick Presenter - Slide";
    preferred-width: root.slide-window-width;
    preferred-height: root.slide-window-height;
    min-width: 640px;
    min-height: 360px;
    background: #111315;
    forward-focus: slide-focus;

    slide-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.exit-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(Space);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(PageDown);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(PageUp);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Backspace);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Home);
            activated => {
                root.keyboard-first-page();
            }
        }

        KeyBinding {
            keys: @keys(End);
            activated => {
                root.keyboard-last-page();
            }
        }

        KeyBinding {
            keys: @keys(F5);
            activated => {
                root.toggle-slide-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(F);
            activated => {
                root.toggle-slide-fullscreen();
            }
        }

        SlideView {
            page-image: root.page-image;
            page-aspect-ratio: root.page-aspect-ratio;
            width: parent.width;
            height: parent.height;
        }
    }
}
