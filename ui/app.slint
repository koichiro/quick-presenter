component ThumbnailTile inherits Rectangle {
    in property <ThumbnailItem> thumbnail;
    callback clicked(int);

    height: 92px;
    background: root.thumbnail.is_current ? #23395d : #111315;
    border-color: root.thumbnail.is_current ? #8ab4f8 : #3c4043;
    border-width: root.thumbnail.is_current ? 2px : 1px;

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked(root.thumbnail.page_index);
        }
    }

    Image {
        source: root.thumbnail.image;
        image-fit: contain;
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: 62px;
    }

    Text {
        text: root.thumbnail.page_label;
        color: root.thumbnail.is_current ? #f1f3f4 : #d9dce0;
        x: 6px;
        y: 69px;
        width: parent.width - 12px;
        height: 18px;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ThumbnailPane inherits Rectangle {
    in property <[ThumbnailItem]> thumbnails;
    in property <int> current-page-index: 0;
    callback jump-to-page(int);
    callback request-thumbnail-range(int, int);

    background: transparent;
    clip: true;
    private property <length> scrollbar-gutter-width: 12px;
    private property <length> tile-height: 98px;
    private property <length> current-item-y: scroll-view.content-y + root.current-page-index * root.tile-height;
    private property <int> visible-start-index: max(0, round(-scroll-view.content-y / root.tile-height));
    private property <int> visible-end-index: min(root.thumbnails.length - 1, max(0, round((-scroll-view.content-y + scroll-view.visible-height) / root.tile-height) + 1));

    function bring-current-into-view() {
        if root.current-page-index < 0 || root.current-page-index >= root.thumbnails.length {
            return;
        }

        if current-item-y < 0px {
            scroll-view.content-y += 0px - current-item-y;
        }

        if current-item-y + tile-height > scroll-view.visible-height {
            scroll-view.content-y -= current-item-y + tile-height - scroll-view.visible-height;
        }
    }

    function request-visible-thumbnails() {
        if root.thumbnails.length <= 0 {
            return;
        }

        root.request-thumbnail-range(root.visible-start-index, root.visible-end-index);
    }

    changed current-page-index => {
        root.bring-current-into-view();
        root.request-visible-thumbnails();
    }

    changed thumbnails => {
        root.request-visible-thumbnails();
    }

    changed visible-start-index => {
        root.request-visible-thumbnails();
    }

    changed visible-end-index => {
        root.request-visible-thumbnails();
    }

    scroll-view := ScrollView {
        width: parent.width + root.scrollbar-gutter-width;
        height: parent.height;
        content-width: parent.width;

        VerticalBox {
            width: root.width;
            spacing: 6px;

            for thumbnail in root.thumbnails: ThumbnailTile {
                thumbnail: thumbnail;
                width: parent.width;
                clicked(page-index) => {
                    root.jump-to-page(page-index);
                }
            }
        }
    }
}

export component PresenterWindow inherits Window {
    icon: @image-url("../assets/icons/png/quick-presenter-icon-256.png");
    in property <string> audience-address;
    in property <string> audience-status: "Stopped";
    in property <string> audience-alert-title;
    in property <string> audience-alert-guidance;
    in property <string> audience-url;
    in property <string> audience-code;
    in property <image> audience-qr;
    in property <bool> audience-active: false;
    in property <bool> audience-panel-expanded: false;
    callback audience-toggle-panel();
    in property <bool> audience-can-start: false;
    in property <int> audience-count: 0;
    in property <bool> audience-guide-visible: false;
    out property <length> audience-panel-height: root.audience-panel-expanded ? root.audience-expanded-height : 48px;
    // Infer the equivalent expanded height while collapsed so resizing the
    // window by the hidden footer height keeps slides and notes unchanged.
    out property <length> audience-expanded-height: root.audience-panel-expanded
        ? clamp(round((root.height - root.inline-menu-height) / 1px * 0.28) * 1px, 282px, 360px)
        : clamp(round((root.height - root.inline-menu-height - 48px) / 1px * (0.28 / 0.72)) * 1px, 282px, 360px);
    out property <length> presenter-minimum-height: root.audience-panel-expanded ? 842px : 608px;
    out property <bool> audience-history-visible: audience-panel.visible;
    out property <bool> audience-url-visible: audience-url-row.visible;
    out property <length> audience-footer-bottom: root.audience-panel-expanded ? root.audience-url-bottom : root.audience-toggle-bottom;
    in property <bool> audience-busy: false;
    in property <string> audience-recent-reactions;
    in property <string> audience-comment-history;
    out property <length> audience-history-height: comment-history.preferred-height;
    out property <length> audience-history-visible-height: comment-history-scroll.visible-height;
    in property <bool> audience-comments-paused;
    in property <bool> audience-flowing-enabled: true;
    in property <bool> audience-bubbles-enabled: false;
    callback audience-set-comment-display(bool, bool);
    callback audience-toggle-comments();
    in property <int> audience-reaction-count;
    callback audience-open-url();
    callback audience-copy-url();
    callback audience-toggle-session();
    callback audience-import-configuration();
    callback audience-reset-configuration();
    callback audience-confirm-import(bool);
    in property <string> audience-import-preview;
    in property <bool> audience-can-import: true;
    in property <bool> audience-recovery-pending: false;
    in-out property <bool> settings-visible: false;
    callback audience-next-address();
    callback audience-refresh-addresses();
    in property <image> current-page-image;
    in property <image> next-page-image;
    in property <float> current-page-aspect-ratio: 16.0 / 9.0;
    in property <float> next-page-aspect-ratio: 16.0 / 9.0;
    in property <bool> has-next-page: false;
    in property <bool> has-notes: false;
    in property <string> document-title: "No PDF opened";
    in property <string> page-label: "";
    in property <string> notes-text: "";
    in property <float> notes-font-size: 12;
    out property <length> audience-panel-right: audience-panel.x + audience-panel.width;
    out property <string> audience-toggle-label: audience-live-toggle.text;
    out property <string> audience-url-text: audience-url-link.text;
    out property <bool> audience-url-copy-enabled: audience-url-copy.enabled;
    out property <bool> audience-url-copy-fits: audience-url-field.x + audience-url-field.width + 8px <= audience-url-copy.x
        && audience-url-copy.x + audience-url-copy.width <= audience-url-row.width
        && audience-url-copy.y >= 0px
        && audience-url-copy.y + audience-url-copy.height <= audience-url-row.height;
    out property <bool> audience-address-controls-inline: next-address.x >= address-text.x + address-text.width && refresh-address.x >= next-address.x + next-address.width && abs(next-address.y - refresh-address.y) < 1px;
    out property <length> audience-url-bottom: audience-url-row.y + audience-url-row.height;
    out property <length> audience-url-top: audience-url-row.y;
    out property <length> audience-panel-bottom: audience-panel.y + audience-panel.height;
    out property <length> audience-panel-top: audience-panel.y;
    out property <length> audience-toggle-bottom: audience-toggle-row.y + audience-live-toggle.y + audience-live-toggle.height;
    out property <length> audience-toggle-y: audience-toggle-row.y;
    out property <length> notes-area-bottom: main-area.y + main-area.height;
    out property <length> thumbnails-left: main-area.x + thumbnail-column.x;
    out property <length> thumbnails-bottom: main-area.y + thumbnail-column.y + thumbnail-column.height;
    out property <length> audience-panel-width: audience-panel.width;
    out property <string> audience-count-label: "👥" + audience-count-text.text;
    out property <bool> audience-toolbar-ordered: audience-disclosure.x + audience-disclosure.width <= audience-count.x
        && audience-count.x + audience-count.width <= audience-led.x
        && audience-led.x + audience-led.width <= audience-live-toggle.x
        && audience-pause.x + audience-pause.width <= address-text.x
        && refresh-address.x + refresh-address.width <= audience-toggle-row.width;
    out property <length> audience-reactions-width: audience-reactions.width;
    out property <length> notes-layout-slide-width: current-slide-with-progress.page-surface-width;
    out property <length> notes-layout-slide-height: current-slide-with-progress.page-surface-height;
    out property <length> presenter-current-column-width: main-area.left-column-width;
    out property <length> presenter-next-column-width: main-area.next-column-width;
    out property <length> presenter-next-preview-height: next-preview-slot.height;
    out property <length> presenter-next-slide-width: next-slide.page-surface-width;
    out property <length> presenter-thumbnail-width: thumbnail-column.width;
    out property <length> notes-layout-outer-width: notes-view.width;
    out property <length> notes-layout-menu-height: inline-menu.height;
    out property <length> notes-layout-main-y: main-area.y;
    out property <length> notes-visible-width: notes-view.visible-width;
    out property <length> notes-visible-height: notes-view.visible-height;
    out property <length> notes-content-height: notes-view.content-height;
    out property <length> notes-text-y: notes-view.text-y;
    in-out property <length> notes-scroll-y <=> notes-view.scroll-y;
    out property <[float]> notes-measured-heights: notes-view.measured-heights;
    in property <bool> audience-fullscreen: false;
    in property <bool> use-physical-control-shortcuts: false;
    in property <bool> use-native-menu-bar: true;
    in property <string> clock-time-label: "--:--";
    in property <string> elapsed-time-label: "00:00";
    in property <string> status-text: "Open a PDF to start";
    in property <bool> has-slide-progress: false;
    in property <float> slide-progress-value: 0.0;
    in property <bool> has-recent-files: false;
    in property <string> recent-file-label-0: "No Recent Files";
    in property <string> recent-file-label-1: "";
    in property <string> recent-file-label-2: "";
    in property <string> recent-file-label-3: "";
    in property <string> recent-file-label-4: "";
    in property <bool> recent-file-0-enabled: false;
    in property <bool> recent-file-1-enabled: false;
    in property <bool> recent-file-2-enabled: false;
    in property <bool> recent-file-3-enabled: false;
    in property <bool> recent-file-4-enabled: false;
    in property <string> about-app-name: "Quick Presenter";
    in property <string> about-version-label: "";
    in property <string> about-license-id: "";
    in property <string> about-license-summary: "";
    in property <string> about-pdfium-version-label: "";
    in property <string> about-pdfium-license-summary: "";
    in property <[ThumbnailItem]> thumbnails: [];
    in property <int> current-page-index: 0;
    property <bool> about-visible: false;
    property <int> active-menu-index: -1;
    property <length> inline-menu-height: root.use-native-menu-bar ? 0px : 28px;
    property <length> presenter-main-height: max(0px, root.height - root.inline-menu-height - 96px - root.audience-panel-height);
    // Reserve readable notes space; larger windows share spare height with slides.
    property <length> presenter-bottom-section-height: max(200px, root.presenter-main-height * 0.34 - 34px);
    property <float> safe-current-page-aspect-ratio: root.current-page-aspect-ratio > 0 ? root.current-page-aspect-ratio : 16.0 / 9.0;
    property <float> safe-next-page-aspect-ratio: root.next-page-aspect-ratio > 0 ? root.next-page-aspect-ratio : 16.0 / 9.0;

    callback open-pdf();
    callback open-recent-file(int);
    callback clear-recent-files();
    callback previous-page();
    callback next-page();
    callback first-page();
    callback last-page();
    callback toggle-black-screen();
    callback toggle-audience-fullscreen();
    callback exit-audience-fullscreen();
    callback show-presenter-window();
    callback show-audience-window();
    callback hide-audience-window();
    callback bring-presenter-window-to-front();
    callback bring-audience-window-to-front();
    callback keyboard-previous-page();
    callback keyboard-next-page();
    callback keyboard-first-page();
    callback keyboard-last-page();
    callback notes-navigation-key(KeyEvent) -> bool;
    callback swap-displays();
    callback jump-to-page(int);
    callback request-thumbnail-range(int, int);
    callback fit-notes-font-size(bool, float, float, [float]);

    title: "Quick Presenter";
    preferred-width: 1024px;
    preferred-height: root.audience-panel-expanded ? 1002px : 768px;
    min-width: 800px;
    min-height: root.presenter-minimum-height;
    background: #202124;
    forward-focus: presenter-focus;

    public function open-settings() {
        root.active-menu-index = -1;
        root.settings-visible = true;
        settings-focus.focus();
    }

    public function close-settings() {
        root.audience-confirm-import(false);
        root.settings-visible = false;
        presenter-focus.focus();
    }

    // BEGIN_NATIVE_MENU_BAR
    if root.use-native-menu-bar: MenuBar {
        Menu {
            title: "Application";
            MenuItem {
                title: "Settings...";
                activated => { root.open-settings(); }
            }
        }
        Menu {
            title: "File";

            MenuItem {
                title: "Open PDF...";
                activated => {
                    root.open-pdf();
                }
            }

            Menu {
                title: "Open Recent";
                enabled: root.has-recent-files;

                MenuItem {
                    title: root.recent-file-label-0;
                    enabled: root.recent-file-0-enabled;
                    activated => { root.open-recent-file(0); }
                }

                MenuItem {
                    title: root.recent-file-label-1;
                    enabled: root.recent-file-1-enabled;
                    activated => { root.open-recent-file(1); }
                }

                MenuItem {
                    title: root.recent-file-label-2;
                    enabled: root.recent-file-2-enabled;
                    activated => { root.open-recent-file(2); }
                }

                MenuItem {
                    title: root.recent-file-label-3;
                    enabled: root.recent-file-3-enabled;
                    activated => { root.open-recent-file(3); }
                }

                MenuItem {
                    title: root.recent-file-label-4;
                    enabled: root.recent-file-4-enabled;
                    activated => { root.open-recent-file(4); }
                }

                MenuSeparator { }

                MenuItem {
                    title: "Clear Recent Files";
                    enabled: root.has-recent-files;
                    activated => {
                        root.clear-recent-files();
                    }
                }
            }
        }

        Menu {
            title: "Navigate";

            MenuItem {
                title: "Previous Page";
                activated => {
                    root.previous-page();
                }
            }

            MenuItem {
                title: "Next Page";
                activated => {
                    root.next-page();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "First Page";
                activated => {
                    root.first-page();
                }
            }

            MenuItem {
                title: "Last Page";
                activated => {
                    root.last-page();
                }
            }
        }

        Menu {
            title: "View";

            MenuItem {
                title: "Toggle Audience Fullscreen";
                activated => {
                    root.toggle-audience-fullscreen();
                }
            }

            MenuItem {
                title: "Toggle Black Screen";
                activated => {
                    root.toggle-black-screen();
                }
            }
        }

        Menu {
            title: "Window";

            MenuItem {
                title: "Show Presenter Window";
                activated => {
                    root.show-presenter-window();
                }
            }

            MenuItem {
                title: "Show Audience Window";
                activated => {
                    root.show-audience-window();
                }
            }

            MenuItem {
                title: "Hide Audience Window";
                activated => {
                    root.hide-audience-window();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "Bring Presenter Window to Front";
                activated => {
                    root.bring-presenter-window-to-front();
                }
            }

            MenuItem {
                title: "Bring Audience Window to Front";
                activated => {
                    root.bring-audience-window-to-front();
                }
            }
        }

        Menu {
            title: "Help";

            MenuItem {
                title: "About Quick Presenter";
                activated => {
                    root.about-visible = true;
                }
            }
        }
    }
    // END_NATIVE_MENU_BAR

    presenter-focus := FocusScope {
        enabled: !root.settings-visible;
        width: root.width;
        height: root.height;

        KeyBinding {
            keys: @keys(Space);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(PageDown);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(PageUp);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Backspace);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Home);
            activated => {
                root.keyboard-first-page();
            }
        }

        if !root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Control + A);
            activated => {
                root.keyboard-first-page();
            }
        }

        if root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Meta + A);
            activated => {
                root.keyboard-first-page();
            }
        }

        KeyBinding {
            keys: @keys(End);
            activated => {
                root.keyboard-last-page();
            }
        }

        if !root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Control + E);
            activated => {
                root.keyboard-last-page();
            }
        }

        if root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Meta + E);
            activated => {
                root.keyboard-last-page();
            }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.exit-audience-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(F5);
            activated => {
                root.toggle-audience-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(F);
            activated => {
                root.toggle-audience-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(B);
            activated => {
                root.toggle-black-screen();
            }
        }

        KeyBinding {
            keys: @keys(X);
            activated => {
                root.swap-displays();
            }
        }

        Rectangle {
            width: root.width;
            height: root.height;
            background: #202124;

            HorizontalBox {
                x: 12px;
                y: root.inline-menu-height + 12px;
                width: parent.width - 24px;
                height: 36px;
                spacing: 8px;
                padding: 0px;

                Button {
                    height: 32px;
                    text: "Open";
                    clicked => {
                        root.open-pdf();
                    }
                }

                NavigationButton {
                    icon: @image-url("../assets/navigation/first.svg");
                    action-name: "First Page";
                    shortcut-label: "Home / Ctrl+A";
                    clicked => {
                        root.first-page();
                    }
                }

                NavigationButton {
                    icon: @image-url("../assets/navigation/previous.svg");
                    action-name: "Previous Page";
                    shortcut-label: "Left / PgUp";
                    clicked => {
                        root.previous-page();
                    }
                }

                NavigationButton {
                    icon: @image-url("../assets/navigation/next.svg");
                    action-name: "Next Page";
                    shortcut-label: "Space / Right";
                    clicked => {
                        root.next-page();
                    }
                }

                NavigationButton {
                    icon: @image-url("../assets/navigation/last.svg");
                    action-name: "Last Page";
                    shortcut-label: "End / Ctrl+E";
                    clicked => {
                        root.last-page();
                    }
                }

                Button {
                    height: 32px;
                    text: root.audience-fullscreen ? "Exit Fullscreen" : "Fullscreen";
                    clicked => {
                        root.toggle-audience-fullscreen();
                    }
                }

                Button {
                    height: 32px;
                    text: "Black";
                    clicked => {
                        root.toggle-black-screen();
                    }
                }

                Text {
                    text: root.document-title;
                    color: white;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: root.elapsed-time-label;
                    color: #f1f3f4;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.clock-time-label;
                    color: #d9dce0;
                    vertical-alignment: center;
                }

                Text {
                    text: root.page-label;
                    color: #d9dce0;
                    vertical-alignment: center;
                }
            }

            main-area := Rectangle {
                x: 12px;
                y: root.inline-menu-height + 54px;
                width: parent.width - 24px;
                height: root.presenter-main-height;
                property <length> column-gap: 10px;
                // Share extra width at 2:1, including on 4K and larger displays.
                property <length> next-column-width: max(260px, (main-area.width - main-area.thumbnail-column-width - main-area.column-gap * 2) / 3);
                property <length> thumbnail-column-width: clamp(main-area.width * 0.10, 128px, 192px);
                property <length> left-column-width: max(0px, main-area.width - main-area.next-column-width - main-area.thumbnail-column-width - main-area.column-gap * 2);
                property <length> current-slide-natural-height: main-area.left-column-width / root.safe-current-page-aspect-ratio + (root.has-slide-progress ? 4px : 0px);
                property <length> top-section-height: min(main-area.current-slide-natural-height, max(0px, main-area.height - root.presenter-bottom-section-height - 34px));
                property <length> lower-section-y: main-area.top-section-height;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: main-area.left-column-width;
                    height: parent.height;

                    current-slide-with-progress := CurrentSlideWithProgress {
                        x: 0px;
                        y: 0px;
                        page-image: root.current-page-image;
                        page-aspect-ratio: root.current-page-aspect-ratio;
                        has-progress: root.has-slide-progress;
                        progress-value: root.slide-progress-value;
                        width: parent.width;
                        height: main-area.top-section-height;
                    }

                    Rectangle {
                        y: main-area.lower-section-y + 6px;
                        height: 22px;
                        width: parent.width;

                        Text {
                            x: (parent.width - self.width) / 2;
                            width: parent.width;
                            height: parent.height;
                            text: "Notes";
                            color: #d9dce0;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        y: main-area.lower-section-y + 34px;
                        width: parent.width;
                        height: max(0px, parent.height - self.y);

                        notes-view := NotesView {
                            navigation-key(event) => { root.notes-navigation-key(event) }
                            x: (parent.width - self.width) / 2;
                            width: parent.width;
                            height: parent.height;
                            has-notes: root.has-notes;
                            notes-text: root.notes-text;
                            font-size: root.notes-font-size * 1px;
                            fit-font-size(has-notes, width, height, measurements) => {
                                root.fit-notes-font-size(has-notes, width, height, measurements);
                            }
                        }
                    }
                }

                Rectangle {
                    x: main-area.left-column-width + main-area.column-gap;
                    y: 0px;
                    width: main-area.next-column-width;
                    height: parent.height;
                    // Size the preview from the rendered current slide, not just its column:
                    // height-constrained slides can leave substantial horizontal letterboxing.
                    property <length> preview-width: min(self.width, current-slide-with-progress.page-surface-width / 2);
                    property <length> preview-height: min(self.preview-width / root.safe-next-page-aspect-ratio, main-area.top-section-height);

                    next-preview-slot := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.preview-width;
                        height: parent.preview-height;

                        next-slide := SlideView {
                            x: 0px;
                            y: 0px;
                            page-image: root.next-page-image;
                            page-aspect-ratio: root.next-page-aspect-ratio;
                            align-page-to-top: true;
                            visible: root.has-next-page;
                            width: parent.width;
                            height: parent.height;
                        }

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            visible: !root.has-next-page;
                            background: #111315;
                            border-color: #3c4043;
                            border-width: 1px;
                            width: parent.width;
                            height: parent.height;

                            Text {
                                text: "No next slide";
                                color: #9aa0a6;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }

                    Text {
                        x: 0px;
                        y: main-area.lower-section-y + 6px;
                        text: "Keys";
                        color: #d9dce0;
                        width: parent.width;
                        height: 22px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }

                    KeyboardBindingsPanel {
                        x: 0px;
                        y: main-area.lower-section-y + 34px;
                        width: min(480px, parent.width);
                        height: min(200px, max(0px, parent.height - self.y));
                    }
                }

                thumbnail-column := Rectangle {
                    x: main-area.left-column-width + main-area.column-gap + main-area.next-column-width + main-area.column-gap;
                    y: 0px;
                    width: main-area.thumbnail-column-width;
                    height: root.audience-footer-bottom - main-area.y - self.y;
                    background: #111315;
                    border-color: #3c4043;
                    border-width: 1px;

                    ThumbnailPane {
                        x: 0px;
                        y: 0px;
                        thumbnails: root.thumbnails;
                        current-page-index: root.current-page-index;
                        width: parent.width;
                        height: parent.height;
                        jump-to-page(page-index) => {
                            root.jump-to-page(page-index);
                        }
                        request-thumbnail-range(first-index, last-index) => {
                            root.request-thumbnail-range(first-index, last-index);
                        }
                    }
                }
            }

            Text {
                x: 12px;
                y: max(0px, parent.height - 36px);
                width: parent.width - 24px;
                text: root.status-text;
                color: #d9dce0;
                height: 24px;
                vertical-alignment: center;
                overflow: elide;
            }

            audience-toggle-row := Rectangle {
                property <bool> led-dim: false;
                Timer {
                    interval: 500ms;
                    running: root.audience-active && root.audience-comments-paused;
                    triggered => { audience-toggle-row.led-dim = !audience-toggle-row.led-dim; }
                }
                x: main-area.x;
                y: main-area.y + main-area.height + 6px;
                width: main-area.width - main-area.thumbnail-column-width - main-area.column-gap;
                height: 36px;
                HorizontalBox {
                    padding: 0px;
                    spacing: parent.width < 760px ? 4px : 8px;
                    audience-disclosure := AudienceIconButton {
                        icon: root.audience-panel-expanded ? @image-url("../assets/navigation/collapse.svg") : @image-url("../assets/navigation/expand.svg");
                        action-name: root.audience-panel-expanded ? "Collapse Audience Live pane" : "Expand Audience Live pane";
                        tooltip-text: root.audience-panel-expanded ? "Hide reactions and comment history" : "Show reactions and comment history";
                        clicked => { root.audience-toggle-panel(); }
                    }
                    audience-count := HorizontalBox {
                        padding: 0px;
                        spacing: 2px;
                        horizontal-stretch: 0;
                        Rectangle {
                            width: 20px;
                            height: 36px;
                            Image {
                                source: @image-url("../assets/navigation/audience.svg");
                                y: (parent.height - self.height) / 2;
                                width: 20px;
                                height: 20px;
                                accessible-role: image;
                                accessible-label: "Connected audience";
                            }
                        }
                        audience-count-text := Text {
                            text: "(" + root.audience-count + ")";
                            accessible-label: "Connected audience: " + root.audience-count;
                            color: white;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                    audience-led := Rectangle {
                        width: 16px;
                        height: 36px;
                        Rectangle {
                            x: 2px;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.audience-active ? #36c56b : #666b70;
                            opacity: root.audience-active && root.audience-comments-paused && audience-toggle-row.led-dim ? 0.2 : 1;
                        }
                    }
                    audience-live-toggle := Button {
                        text: root.audience-active ? "Audience Live OFF 👍️" : "Audience Live ON  👍️";
                        min-width: 160px;
                        max-width: 160px;
                        enabled: !root.audience-busy && (root.audience-active || root.audience-can-start);
                        clicked => { root.audience-toggle-session(); }
                    }
                    audience-pause := Button {
                        text: root.audience-comments-paused ? "Resume" : "Pause";
                        enabled: root.audience-active && !root.audience-busy;
                        clicked => { root.audience-toggle-comments(); }
                    }
                    address-text := Text {
                        text: root.audience-address;
                        accessible-label: "Server IP address: " + root.audience-address;
                        color: #9aa0a6;
                        font-size: 11px;
                        min-width: 120px;
                        max-width: 120px;
                        horizontal-stretch: 0;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    next-address := Button {
                        text: "Next";
                        accessible-label: "Next server address";
                        enabled: !root.audience-active;
                        clicked => { root.audience-next-address(); }
                    }
                    refresh-address := Button {
                        text: "Refresh";
                        accessible-label: "Refresh server addresses";
                        enabled: !root.audience-active;
                        clicked => { root.audience-refresh-addresses(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            audience-panel := Rectangle {
                x: main-area.x;
                y: audience-toggle-row.y + audience-toggle-row.height + 6px;
                width: audience-toggle-row.width;
                height: root.audience-panel-expanded ? root.audience-expanded-height - 90px : 0px;
                visible: root.audience-panel-expanded;
                background: #111315;
                border-color: #3c4043;
                border-width: 1px;
                clip: true;
                audience-reactions := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    background: #202124;
                    border-color: #3c4043;
                    border-width: 1px;
                    VerticalBox {
                        padding: 10px;
                        Text { text: "Reactions: " + root.audience-reaction-count; color: white; font-weight: 700; }
                        Text {
                            text: root.audience-recent-reactions;
                            color: white;
                            font-size: 22px;
                            overflow: elide;
                        }
                        comment-history-scroll := ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: comment-history.preferred-height;
                            content-y: min(0px, self.visible-height - self.content-height);
                            comment-history := Text {
                                width: parent.width;
                                height: self.preferred-height;
                                text: root.audience-comment-history == "" ? "Waiting for comments…" : root.audience-comment-history;
                                color: white;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                if root.audience-alert-title != "": Rectangle {
                    x: 0px; y: 0px;
                    width: parent.width; height: parent.height;
                    background: #30251a;
                    border-color: #f0b45a;
                    border-width: 2px;
                    VerticalBox {
                        padding: 14px; spacing: 8px;
                        Text { text: "⚠ " + root.audience-alert-title; color: #ffd18a; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                        Text { text: root.audience-alert-guidance; color: white; font-size: 14px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            audience-url-row := Rectangle {
                x: audience-panel.x;
                y: audience-panel.y + audience-panel.height + 6px;
                width: audience-panel.width;
                height: root.audience-panel-expanded ? 36px : 0px;
                visible: root.audience-panel-expanded;
                audience-url-field := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: max(0px, parent.width - 44px);
                    height: parent.height;
                    background: #111315;
                    border-color: #3c4043;
                    border-width: 1px;
                    audience-url-link := Text {
                        x: 8px;
                        y: 3px;
                        width: max(0px, parent.width - 16px);
                        height: max(0px, parent.height - 6px);
                        text: root.audience-url;
                        overflow: elide;
                        font-size: 12px;
                        color: #8ab4f8;
                        vertical-alignment: center;
                        TouchArea {
                            enabled: root.audience-url != "";
                            mouse-cursor: pointer;
                            clicked => { root.audience-open-url(); }
                        }
                    }
                }
                audience-url-copy := AudienceIconButton {
                    width: 36px;
                    height: 32px;
                    x: parent.width - self.width;
                    y: 2px;
                    icon: @image-url("../assets/navigation/copy.svg");
                    action-name: "Copy join URL";
                    tooltip-text: "Copy join URL";
                    enabled: root.audience-active && !root.audience-busy && root.audience-url != "";
                    clicked => { root.audience-copy-url(); }
                }
            }

            inline-menu := Rectangle {
                y: 0px;
                width: parent.width;
                height: root.inline-menu-height;
                visible: !root.use-native-menu-bar;
                background: #f1f3f4;

                PresenterMenuButton {
                    x: 0px;
                    width: 100px;
                    text: "Application";
                    active: root.active-menu-index == 5;
                    clicked => { root.active-menu-index = root.active-menu-index == 5 ? -1 : 5; }
                }

                PresenterMenuButton {
                    x: 100px;
                    width: 56px;
                    text: "File";
                    active: root.active-menu-index == 0;
                    clicked => { root.active-menu-index = root.active-menu-index == 0 ? -1 : 0; }
                }

                PresenterMenuButton {
                    x: 156px;
                    width: 92px;
                    text: "Navigate";
                    active: root.active-menu-index == 1;
                    clicked => { root.active-menu-index = root.active-menu-index == 1 ? -1 : 1; }
                }

                PresenterMenuButton {
                    x: 248px;
                    width: 64px;
                    text: "View";
                    active: root.active-menu-index == 2;
                    clicked => { root.active-menu-index = root.active-menu-index == 2 ? -1 : 2; }
                }

                PresenterMenuButton {
                    x: 312px;
                    width: 86px;
                    text: "Window";
                    active: root.active-menu-index == 3;
                    clicked => { root.active-menu-index = root.active-menu-index == 3 ? -1 : 3; }
                }

                PresenterMenuButton {
                    x: 398px;
                    width: 64px;
                    text: "Help";
                    active: root.active-menu-index == 4;
                    clicked => { root.active-menu-index = root.active-menu-index == 4 ? -1 : 4; }
                }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 0: Rectangle {
                x: 100px;
                y: root.inline-menu-height;
                width: 220px;
                height: 196px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { y: 0px; width: parent.width; text: "Open PDF..."; clicked => { root.active-menu-index = -1; root.open-pdf(); } }
                PresenterMenuItem { y: 28px; width: parent.width; text: root.recent-file-label-0; enabled: root.recent-file-0-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(0); } }
                PresenterMenuItem { y: 56px; width: parent.width; text: root.recent-file-label-1; enabled: root.recent-file-1-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(1); } }
                PresenterMenuItem { y: 84px; width: parent.width; text: root.recent-file-label-2; enabled: root.recent-file-2-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(2); } }
                PresenterMenuItem { y: 112px; width: parent.width; text: root.recent-file-label-3; enabled: root.recent-file-3-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(3); } }
                PresenterMenuItem { y: 140px; width: parent.width; text: root.recent-file-label-4; enabled: root.recent-file-4-enabled; clicked => { root.active-menu-index = -1; root.open-recent-file(4); } }
                PresenterMenuItem { y: 168px; width: parent.width; text: "Clear Recent Files"; enabled: root.has-recent-files; clicked => { root.active-menu-index = -1; root.clear-recent-files(); } }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 1: Rectangle {
                x: 156px;
                y: root.inline-menu-height;
                width: 180px;
                height: 112px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { y: 0px; width: parent.width; text: "Previous Page"; clicked => { root.active-menu-index = -1; root.previous-page(); } }
                PresenterMenuItem { y: 28px; width: parent.width; text: "Next Page"; clicked => { root.active-menu-index = -1; root.next-page(); } }
                PresenterMenuItem { y: 56px; width: parent.width; text: "First Page"; clicked => { root.active-menu-index = -1; root.first-page(); } }
                PresenterMenuItem { y: 84px; width: parent.width; text: "Last Page"; clicked => { root.active-menu-index = -1; root.last-page(); } }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 2: Rectangle {
                x: 248px;
                y: root.inline-menu-height;
                width: 210px;
                height: 56px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { y: 0px; width: parent.width; text: "Toggle Audience Fullscreen"; clicked => { root.active-menu-index = -1; root.toggle-audience-fullscreen(); } }
                PresenterMenuItem { y: 28px; width: parent.width; text: "Toggle Black Screen"; clicked => { root.active-menu-index = -1; root.toggle-black-screen(); } }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 3: Rectangle {
                x: 312px;
                y: root.inline-menu-height;
                width: 240px;
                height: 140px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { y: 0px; width: parent.width; text: "Show Presenter Window"; clicked => { root.active-menu-index = -1; root.show-presenter-window(); } }
                PresenterMenuItem { y: 28px; width: parent.width; text: "Show Audience Window"; clicked => { root.active-menu-index = -1; root.show-audience-window(); } }
                PresenterMenuItem { y: 56px; width: parent.width; text: "Hide Audience Window"; clicked => { root.active-menu-index = -1; root.hide-audience-window(); } }
                PresenterMenuItem { y: 84px; width: parent.width; text: "Bring Presenter Window to Front"; clicked => { root.active-menu-index = -1; root.bring-presenter-window-to-front(); } }
                PresenterMenuItem { y: 112px; width: parent.width; text: "Bring Audience Window to Front"; clicked => { root.active-menu-index = -1; root.bring-audience-window-to-front(); } }
            }

            if !root.use-native-menu-bar && root.active-menu-index == 4: Rectangle {
                x: 398px;
                y: root.inline-menu-height;
                width: 210px;
                height: 28px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;

                PresenterMenuItem { width: parent.width; text: "About Quick Presenter"; clicked => { root.active-menu-index = -1; root.about-visible = true; } }
            }
            if !root.use-native-menu-bar && root.active-menu-index == 5: Rectangle {
                x: 0px;
                y: root.inline-menu-height;
                width: 220px;
                height: 28px;
                background: #f8f9fa;
                border-color: #c8ccd0;
                border-width: 1px;
                PresenterMenuItem { width: parent.width; text: "Settings..."; clicked => { root.open-settings(); } }
            }

        }

    }

    settings-backdrop := Rectangle {
        visible: root.settings-visible;
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea { width: parent.width; height: parent.height; }
        settings-focus := FocusScope {
            width: parent.width;
            height: parent.height;
            KeyBinding { keys: @keys(Escape); activated => { root.close-settings(); } }
            Rectangle {
                width: min(parent.width - 48px, 600px);
                height: min(parent.height - 48px, 540px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #202124;
                border-color: #5f6368;
                border-width: 1px;
                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "Settings"; color: white; font-size: 24px; }
                    Text { text: "Comment display"; color: white; font-size: 18px; }
                    VerticalBox {
                        spacing: 4px;
                        padding: 0px;
                        CommentDisplaySwitch {
                            text: "Flowing comments";
                            checked: root.audience-flowing-enabled;
                            toggled => { root.audience-set-comment-display(!root.audience-flowing-enabled, root.audience-bubbles-enabled); }
                        }
                        CommentDisplaySwitch {
                            text: "Bubble comments";
                            checked: root.audience-bubbles-enabled;
                            toggled => { root.audience-set-comment-display(root.audience-flowing-enabled, !root.audience-bubbles-enabled); }
                        }
                    }
                    Text { text: "Both styles can be enabled. Changes apply immediately."; color: #d9dce0; wrap: word-wrap; }
                    Text { text: "Audience Live"; color: white; font-size: 18px; }
                    Text { text: "Import relay settings, or Reset to use the local server. Changes apply to the next start and preserve other settings."; color: #d9dce0; wrap: word-wrap; }
                    if root.audience-active || root.audience-busy: Text { text: "Stop Audience Live before changing relay settings."; color: #ffd18a; wrap: word-wrap; }
                    if root.audience-recovery-pending: Text {
                        text: "Relay recovery is pending. Close Settings, retry Audience Live on, then stop it before changing settings.";
                        color: #ffd18a;
                        wrap: word-wrap;
                    }
                    Text { text: root.audience-status; color: #d9dce0; wrap: word-wrap; }
                    if root.audience-import-preview == "": HorizontalBox {
                        Button {
                            text: "Import settings...";
                            enabled: root.audience-can-import && !root.audience-active && !root.audience-busy && !root.audience-recovery-pending;
                            clicked => { root.audience-import-configuration(); }
                        }
                        Button {
                            text: "Reset";
                            enabled: root.audience-can-import && !root.audience-active && !root.audience-busy && !root.audience-recovery-pending;
                            clicked => { root.audience-reset-configuration(); }
                        }
                    }
                    if root.audience-import-preview != "": VerticalBox {
                        Text { text: "Destination: " + root.audience-import-preview; color: white; wrap: word-wrap; }
                        Text { text: "Apply for the next start? Import does not start a session."; color: #d9dce0; wrap: word-wrap; }
                        HorizontalBox {
                            Button { text: "Cancel import"; clicked => { root.audience-confirm-import(false); } }
                            Button { text: "Import"; clicked => { root.audience-confirm-import(true); } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Button { text: "Close"; clicked => { root.close-settings(); } }
                }
            }
        }
    }

    if root.about-visible : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.about-visible = false;
            }
        }

        Rectangle {
            width: min(parent.width - 48px, 560px);
            height: min(parent.height - 48px, 420px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #202124;
            border-color: #5f6368;
            border-width: 1px;

            VerticalBox {
                padding: 24px;
                spacing: 12px;

                HorizontalBox {
                    height: 96px;
                    spacing: 16px;

                    Image {
                        source: @image-url("../assets/icons/png/quick-presenter-icon-128.png");
                        image-fit: contain;
                        width: 88px;
                        height: 88px;
                    }

                    VerticalBox {
                        spacing: 4px;
                        vertical-stretch: 1;

                        Text {
                            text: root.about-app-name;
                            color: #f1f3f4;
                            font-size: 28px;
                            font-weight: 700;
                            height: 36px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.about-version-label;
                            color: #d9dce0;
                            height: 24px;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #3c4043;
                }

                Text {
                    text: "Application License";
                    color: #f1f3f4;
                    font-weight: 700;
                    height: 24px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.about-license-id + "\n" + root.about-license-summary;
                    color: #d9dce0;
                    wrap: word-wrap;
                    height: 54px;
                }

                Text {
                    text: "Bundled Components";
                    color: #f1f3f4;
                    font-weight: 700;
                    height: 24px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.about-pdfium-version-label + "\n" + root.about-pdfium-license-summary;
                    color: #d9dce0;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                    overflow: clip;
                }

                HorizontalBox {
                    height: 36px;
                    alignment: end;

                    Button {
                        text: "Close";
                        clicked => {
                            root.about-visible = false;
                        }
                    }
                }
            }
        }
    }
}

export component AudienceWindow inherits Window {
    icon: @image-url("../assets/icons/png/quick-presenter-icon-256.png");
    in property <bool> audience-guide-visible: false;
    in property <bool> black-screen-active: false;
    in property <[ReactionOverlayItem]> audience-overlay;
    in property <[CommentOverlayItem]> audience-comments;
    in property <[BubbleOverlayItem]> audience-bubbles;
    in property <string> comment-measure-text;
    out property <float> comment-measure-width: comment-measure.preferred-width / 1px;
    callback audience-clear-overlay();
    in property <image> audience-qr;
    in property <string> audience-url;
    in property <string> audience-code;
    in property <string> audience-status;
    in property <image> page-image;
    in property <float> page-aspect-ratio: 16.0 / 9.0;
    in property <length> audience-window-width: 1024px;
    in property <length> audience-window-height: 720px;
    in property <length> titlebar-compensation-height: 0px;
    in property <bool> use-physical-control-shortcuts: false;

    callback exit-fullscreen();
    callback toggle-black-screen();
    callback toggle-audience-fullscreen();
    callback keyboard-previous-page();
    callback keyboard-next-page();
    callback keyboard-first-page();
    callback keyboard-last-page();
    callback swap-displays();

    title: "Quick Presenter - Audience";
    preferred-width: root.audience-window-width;
    preferred-height: root.audience-window-height;
    min-width: 640px;
    min-height: 360px;
    background: #111315;
    forward-focus: audience-focus;

    audience-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.exit-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(Space);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(PageDown);
            activated => {
                root.keyboard-next-page();
            }
        }

        KeyBinding {
            keys: @keys(LeftArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(PageUp);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Backspace);
            activated => {
                root.keyboard-previous-page();
            }
        }

        KeyBinding {
            keys: @keys(Home);
            activated => {
                root.keyboard-first-page();
            }
        }

        if !root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Control + A);
            activated => {
                root.keyboard-first-page();
            }
        }

        if root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Meta + A);
            activated => {
                root.keyboard-first-page();
            }
        }

        KeyBinding {
            keys: @keys(End);
            activated => {
                root.keyboard-last-page();
            }
        }

        if !root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Control + E);
            activated => {
                root.keyboard-last-page();
            }
        }

        if root.use-physical-control-shortcuts: KeyBinding {
            keys: @keys(Meta + E);
            activated => {
                root.keyboard-last-page();
            }
        }

        KeyBinding {
            keys: @keys(F5);
            activated => {
                root.toggle-audience-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(F);
            activated => {
                root.toggle-audience-fullscreen();
            }
        }

        KeyBinding {
            keys: @keys(B);
            activated => {
                root.toggle-black-screen();
            }
        }

        KeyBinding {
            keys: @keys(X);
            activated => {
                root.swap-displays();
            }
        }

        SlideView {
            visible: !root.audience-guide-visible;
            page-image: root.page-image;
            page-aspect-ratio: root.page-aspect-ratio;
            width: parent.width;
            height: parent.height;
        }

        if root.audience-guide-visible && !root.black-screen-active: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #111315;
            VerticalBox {
                padding: min(root.width, root.height) * 0.04;
                spacing: 12px;
                Text { text: "Quick Presenter · Audience Live"; color: white; font-size: min(root.width, root.height) * 0.045; horizontal-alignment: center; }
                Text { text: root.audience-code == "" ? "Page 0 · Join this session" : "Page 0 · Session " + root.audience-code; color: #d9dce0; font-size: 22px; horizontal-alignment: center; }
                Image { source: root.audience-qr; image-fit: contain; image-rendering: pixelated; min-height: 100px; vertical-stretch: 1; }
                Text { text: root.audience-url == "" ? root.audience-status : root.audience-url; color: white; font-size: 18px; wrap: word-wrap; horizontal-alignment: center; }
                Text { text: "Scan the QR code on the same Wi-Fi or LAN."; color: #d9dce0; font-size: 20px; horizontal-alignment: center; }
            }
        }
        if !root.black-screen-active: Rectangle {
            width: parent.width;
            height: parent.height;
            clip: true;
            for reaction in root.audience-overlay: Image {
                width: min(64px, max(24px, parent.height / 14));
                height: self.width;
                x: reaction.x * max(0px, parent.width - self.width);
                y: reaction.y * max(0px, parent.height - self.height);
                opacity: reaction.opacity;
                source: reaction.kind == 0 ? @image-url("../assets/audience/reactions/thumbs-up.svg") :
                    reaction.kind == 1 ? @image-url("../assets/audience/reactions/heart.svg") :
                    reaction.kind == 2 ? @image-url("../assets/audience/reactions/applause.svg") :
                    reaction.kind == 3 ? @image-url("../assets/audience/reactions/laugh.svg") :
                    @image-url("../assets/audience/reactions/question.svg");
            }
        }
        comment-measure := Text {
            visible: false;
            text: root.comment-measure-text;
            font-size: 32px;
            font-weight: 700;
            wrap: no-wrap;
        }
        if !root.black-screen-active: Rectangle {
            property <float> canvas-scale: min(parent.width / 1280px, parent.height / 720px);
            width: 1280px * self.canvas-scale;
            height: 720px * self.canvas-scale;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            clip: true;
            for comment in root.audience-comments: Text {
                x: comment.x * parent.canvas-scale * 1px;
                y: comment.y * parent.canvas-scale * 1px;
                width: (comment.width + 1) * parent.canvas-scale * 1px;
                height: 48px * parent.canvas-scale;
                text: comment.text;
                color: white;
                font-size: 32px * parent.canvas-scale;
                font-weight: 700;
                wrap: no-wrap;
            }
        }
        if !root.black-screen-active: Rectangle {
            width: parent.width;
            height: parent.height;
            bubble-stack := Rectangle {
                property <float> canvas-scale: min(parent.width / 1280px, parent.height / 720px);
                y: parent.height - self.height;
                width: parent.width;
                height: 684px * self.canvas-scale;
                clip: true;
                for bubble in root.audience-bubbles: bubble-card := Rectangle {
                    x: parent.width - self.width - 24px * bubble-stack.canvas-scale;
                    y: (bubble.y - 36) * bubble-stack.canvas-scale * 1px;
                    width: parent.width / 4;
                    height: 120px * bubble-stack.canvas-scale;
                    border-radius: 16px * bubble-stack.canvas-scale;
                    background: #60606080;
                    property <float> scale: bubble-stack.canvas-scale;
                    VerticalLayout {
                        padding: 12px * bubble-card.scale;
                        spacing: 4px * bubble-card.scale;
                        if bubble.name != "": Text {
                            text: bubble.name;
                            color: #eeeeee;
                            font-size: 14px * bubble-card.scale;
                            height: 20px * bubble-card.scale;
                            overflow: elide;
                        }
                        Text {
                            text: bubble.text;
                            color: white;
                            font-size: 22px * bubble-card.scale;
                            wrap: word-wrap;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        if root.black-screen-active: Rectangle { width: parent.width; height: parent.height; background: black; }

    }
}
